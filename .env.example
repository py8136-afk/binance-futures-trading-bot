# Copy this file to ".env" and paste your Binance Futures TESTNET keys.
# Get them at: https://testnet.binancefuture.com  (API Key tab)
# NEVER commit the real .env file. It is git-ignored.

BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# Optional overrides (sane defaults already set in code):
BINANCE_BASE_URL=https://testnet.binancefuture.com
BINANCE_RECV_WINDOW=5000
BINANCE_TIMEOUT=10
